{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velora stable release metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "channel", "applicationId", "versionName", "versionCode", "tag", "sourceCommit", "minSdk", "apk"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"const": "AlekseyVinokurov/Velora"},
    "channel": {"const": "stable"},
    "applicationId": {"const": "io.github.alekseyvinokurov.velora"},
    "versionName": {"type": "string", "maxLength": 40, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "versionCode": {"type": "integer", "minimum": 1, "maximum": 2100000000},
    "tag": {"type": "string", "description": "Exactly v + versionName; checked by the updater."},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "minSdk": {"type": "integer", "minimum": 24, "maximum": 1000},
    "apk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "certificateSha256"],
      "properties": {
        "name": {"type": "string", "description": "Exactly Velora-<versionName>-<versionCode>.apk; checked by the updater."},
        "size": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "certificateSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Must equal the independently pinned release certificate."}
      }
    }
  }
}
